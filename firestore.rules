rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // In a real app, you'd check a dedicated 'admins' collection
      // For this demo, let's assume roles are on the user doc
      // But rules instructions say never rely on client claims.
      // So we use get() on the users collection.
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() <= 10 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 128 &&
             data.role in ['user', 'admin', 'moderator'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stock']) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.stock is int && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'productId', 'rating']) &&
             data.userId == request.auth.uid &&
             data.rating is int && data.rating >= 1 && data.rating <= 5;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['productId', 'addedAt']) &&
             data.productId is string && data.productId.size() <= 128;
    }

    function isValidShowcase(data) {
      return data.keys().hasAll(['userId', 'imageUrl']) &&
             data.userId == request.auth.uid &&
             data.imageUrl is string && data.imageUrl.size() <= 1024;
    }

    // --- Matches ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == existing().role; // Users can't change their own role
      allow delete: if isAdmin();

      match /wishlist/{wishlistId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidProduct(incoming());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin(); 
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update, delete: if isOwner(existing().userId) || isAdmin();
    }

    match /showcase/{showcaseId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidShowcase(incoming());
      allow update: if (isOwner(existing().userId) || isAdmin()) && isValidShowcase(incoming());
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
